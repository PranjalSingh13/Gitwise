{
  "manifest_version": 3,
  "name": "GitWise — GitHub Repository Deep-Scan Companion",
  "version": "1.0.0",
  "description": "One-click repository deep scan, PR poison analyzer, and AI Git Doctor on any GitHub repository.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitWise Companion"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://localhost:4000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
